{
  "name": "iluhaaime",
  "version": "5.1.6",
  "private": true,
  "author": "HullPerse",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:incremental": "bun scripts/build-incremental.ts",
    "build:stages": "bun scripts/build-incremental.ts --plan",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "typecheck:e2e": "tsc --noEmit -p scripts/e2e/tsconfig.json",
    "check:commands": "bun scripts/check-commands.ts",
    "check:configs": "bun scripts/check-configs.ts",
    "data:flags": "bun scripts/build-flags.ts",
    "data:geoip": "bun scripts/build-geoip.ts",
    "data:chip8": "bun scripts/build-chip8-store.ts",
    "lint": "oxlint --config oxlint.config.ts --type-aware",
    "lint:knip": "knip",
    "check:cleanup": "bun scripts/cleanup-inventory.ts --check-code",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:shuffle": "vitest run --isolate --sequence.shuffle",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bun scripts/e2e/run.ts",
    "bench:labs": "labs",
    "bench:labs:compare": "labs compare",
    "bench:all": "labs \"@quick\"",
    "bench:full": "labs",
    "bench:slow": "labs \"@slow\"",
    "bench:rust": "cargo bench --manifest-path src-tauri/Cargo.toml",
    "bench:ipc": "bun scripts/e2e/measure-ipc.ts",
    "bench:stream": "bun scripts/e2e/stream-timing.ts",
    "bench:snapshot": "bun scripts/rank-snapshot.ts",
    "bench:eval": "bun scripts/rank-eval.ts",
    "bench:simulate": "bun scripts/rank-simulate.ts",
    "check": "bun scripts/check-commands.ts && bun scripts/check-configs.ts && ultracite check src package.json tsconfig.json tsconfig.node.json vite.config.ts index.html oxlint.config.ts oxfmt.config.ts",
    "fix": "ultracite fix src package.json tsconfig.json tsconfig.node.json vite.config.ts index.html oxlint.config.ts oxfmt.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@hullperse/hp_utils": "1.0.7",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "~2.7.3",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "@videojs/core": "10.3.0",
    "@videojs/media": "10.3.0",
    "@videojs/react": "10.3.0",
    "@videojs/youtube-video": "10.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "d3-force": "^3.0.1",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@pmndrs/labs": "0.12.0",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/d3-force": "^3.0.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "d3-timer": "^3.0.2",
    "jsdom": "^31.0.0",
    "knip": "^6.45.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-plugin-react-doctor": "^0.9.22",
    "oxlint-tsgolint": "^7.0.2006",
    "playwright-core": "^1.65.0",
    "typescript": "7.0.2",
    "ultracite": "8.1.1",
    "vite": "8.3.7",
    "vitest": "^5.1.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
